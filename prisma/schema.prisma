// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OWNER
  EMPLOYEE
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  password   String?  // Null si es login por Google
  name       String?
  role       Role   @default(OWNER)
  provider   String   // 'credentials' | 'google'
  providerId String?  // ID externo
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id])
  businessId String
  
  expenses   Expense[] // Relación 1:N - un usuario puede tener muchos gastos de sueldo
  profiles   Profile[] // Relación 1:N - un usuario puede tener múltiples perfiles
}

model Profile {
  id          String   @id @default(uuid())
  username    String?  @unique
  avatar      String?
  phone       String?
  secondaryEmail String?
  description String?
  isActive    Boolean  @default(true)
  
  // Relación con User
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  
  // Relación con Business (opcional - para perfiles específicos de negocio)
  business    Business? @relation(fields: [businessId], references: [id])
  businessId  String?
  
  // Campos de auditoría
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, businessId]) // Un usuario solo puede tener un perfil por negocio
}

model Business {
  id         String   @id @default(uuid())
  name       String
  logo       String?
  users      User[]   // Relación 1:N - un negocio puede tener muchos usuarios
  profiles   Profile[] // Relación 1:N - un negocio puede tener muchos perfiles
  products   Product[] // Relación 1:N - un negocio puede tener muchos productos
  sales      Sale[]   // Relación 1:N - un negocio puede tener muchas ventas
  expenses   Expense[] // Relación 1:N - un negocio puede tener muchos gastos
  businessClients BusinessClient[] // Tabla intermedia para relación N:N con clientes
  createdAt  DateTime @default(now())
}

model Product {
  id          String   @id @default(uuid())
  name        String
  price       Float
  description String?
  stock       Int
  business    Business @relation(fields: [businessId], references: [id])
  businessId  String
  productCategories ProductCategory[] // Tabla intermedia para relación N:N con categorías
  saleItems   SaleItem[] // Relación 1:N - un producto puede estar en muchas ventas
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Category {
  id          String   @id @default(uuid())
  name        String
  description String?
  productCategories ProductCategory[] // Tabla intermedia para relación N:N con productos
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Tabla intermedia para relación N:N entre Product y Category
model ProductCategory {
  id         String   @id @default(uuid())
  product    Product  @relation(fields: [productId], references: [id])
  productId  String
  category   Category @relation(fields: [categoryId], references: [id])
  categoryId String
  createdAt  DateTime @default(now())

  @@unique([productId, categoryId]) // Evita duplicados
}

model Client {
  id         String   @id @default(uuid())
  name       String
  email      String?
  phone      String?
  address    String?
  businessClients BusinessClient[] // Tabla intermedia para relación N:N con negocios
  sales      Sale[]   // Relación 1:N - un cliente puede tener muchas ventas
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Tabla intermedia para relación N:N entre Business y Client
model BusinessClient {
  id         String   @id @default(uuid())
  business   Business @relation(fields: [businessId], references: [id])
  businessId String
  client     Client   @relation(fields: [clientId], references: [id])
  clientId   String
  createdAt  DateTime @default(now())

  @@unique([businessId, clientId]) // Evita duplicados
}

model Sale {
  id         String   @id @default(uuid())
  total      Float
  status     SaleStatus @default(PENDING)
  business   Business @relation(fields: [businessId], references: [id])
  businessId String
  client     Client?  @relation(fields: [clientId], references: [id]) // Opcional - venta sin cliente
  clientId   String?
  items      SaleItem[] // Relación 1:N - una venta puede tener muchos items
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model SaleItem {
  id        String  @id @default(uuid())
  quantity  Int
  price     Float   // Precio al momento de la venta
  sale      Sale    @relation(fields: [saleId], references: [id])
  saleId    String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  createdAt DateTime @default(now())
}

model Expense {
  id          String   @id @default(uuid())
  amount      Float
  description String
  type        ExpenseType
  date        DateTime
  business    Business @relation(fields: [businessId], references: [id])
  businessId  String
  user        User?    @relation(fields: [userId], references: [id]) // Opcional - para gastos de sueldo
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum SaleStatus {
  PENDING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum ExpenseType {
  SALARY      // Sueldo - asociado a usuario
  RENT        // Renta
  UTILITIES   // Servicios
  SUPPLIES    // Suministros
  MARKETING   // Marketing
  OTHER       // Otros
}