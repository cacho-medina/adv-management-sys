// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OWNER
  EMPLOYEE
}

enum AuthProvider {
  CREDENTIALS
  GOOGLE
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  password   String?  // Null si es login por Google
  name       String?
  isActive    Boolean  @default(true)
  provider   AuthProvider @default(CREDENTIALS) // Enum en lugar de String
  providerId String?  // ID externo (Google ID, etc.)
  
  // Campos para confirmación de email
  isEmailVerified Boolean @default(false)
  emailVerificationToken String? @unique // Token para verificar email
  emailVerificationExpires DateTime? // Fecha de expiración del token
  
  // Campos para recuperación de contraseña
  passwordResetToken String? @unique
  passwordResetExpires DateTime?
  
  // Campos de auditoría
  registeredAt  DateTime @default(now())
  lastLoginAt   DateTime?
  updatedAt     DateTime @updatedAt
  
  // Relación 1:1 con Profile (opcional)
  profile    Profile?
  
  // Relación N:N con Business a través de UserBusiness
  userBusinesses UserBusiness[]

  // Relaciones con invitaciones
  sentInvitations     BusinessInvitations[] @relation("InvitationsSent")
  acceptedInvitations BusinessInvitations[] @relation("InvitationsAccepted")
}

model Profile {
  id          String   @id @default(uuid())
  username    String?  @unique
  avatar      String?
  phone       String?
  secondaryEmail String?
  description String?
  
  
  // Relación 1:1 con User
  user        User     @relation(fields: [userId], references: [id])
  userId      String   @unique // Garantiza relación 1:1
  
  // Campos de auditoría
  updatedAt   DateTime @updatedAt
}

model Business {
  id         String   @id @default(uuid())
  name       String
  logo       String?
  description String?
  address    String?
  phone      String?
  email      String?
  website    String?

  // Relación con invitaciones
  invitations BusinessInvitations[]
  
  // Relación N:N con User a través de UserBusiness
  userBusinesses UserBusiness[]
  
  products   Product[] // Relación 1:N - un negocio puede tener muchos productos
  sales      Sale[]   // Relación 1:N - un negocio puede tener muchas ventas
  expenses   Expense[] // Relación 1:N - un negocio puede tener muchos gastos
  clients    Client[] // Relación 1:N - un negocio puede tener muchos clientes
  categories Category[] // Categorías específicas del negocio
  payments   Payment[] //pagos recibidos
  discounts   SaleDiscount[] // descuentos aplicados
  createdAt  DateTime @default(now())
}

// Nueva tabla intermedia para relación N:N entre User y Business
model UserBusiness {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  business   Business @relation(fields: [businessId], references: [id])
  businessId String
  
  // Campos adicionales para la relación
  role       Role     @default(EMPLOYEE)

  joinedAt   DateTime @default(now())
  

  @@unique([userId, businessId]) // Evita duplicados
}

model BusinessInvitations {
  id          String   @id @default(uuid())
  
  // Relación con el negocio
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId  String
  
  // Usuario que envía la invitación (owner/admin)
  invitedBy   User     @relation("InvitationsSent", fields: [invitedById], references: [id])
  invitedById String
  
  // Email del destinatario
  email       String
  
  // Token único para la invitación
  token       String   @unique
  
  // Rol que se asignará al empleado
  role        Role     @default(EMPLOYEE)
  
  // Mensaje opcional de la invitación
  message     String?
  
  // Control de expiración y uso
  expiresAt   DateTime
  isUsed      Boolean  @default(false)
  usedAt      DateTime?
  
  // Usuario que aceptó la invitación (si ya fue usada)
  acceptedBy  User?    @relation("InvitationsAccepted", fields: [acceptedById], references: [id])
  acceptedById String?
  
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Índices para optimizar consultas
  @@index([businessId])
  @@index([email])
  @@index([token])
  @@index([expiresAt])
}

enum ProductType {
  PHYSICAL    // Producto físico (ropa, tecnología, etc.)
  DIGITAL     // Producto digital (software, ebooks, etc.)
  SERVICE     // Servicio (consultoría, mantenimiento, etc.)
  FOOD        // Comida y bebidas
  SUBSCRIPTION // Suscripciones
}

model Product {
  id          String      @id @default(uuid())
  name        String
  price       Float
  description String?
  stock       Int         @default(0)
  type        ProductType @default(PHYSICAL)
  
  // Campos específicos por tipo
  sku         String?     @unique // Código de producto
  
  // Campos para productos físicos
  isActive    Boolean     @default(true)
  isFeatured  Boolean     @default(false)
  
  // Relaciones
  business    Business    @relation(fields: [businessId], references: [id])
  businessId  String
  productCategories ProductCategory[]
  productAttributes ProductAttribute[] // Atributos dinámicos
  saleItems   SaleItem[]
  
  // Auditoría
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Category {
  id          String   @id @default(uuid())
  name        String
  description String?
  icon        String?  // Icono para UI
  color       String?  // Color para UI
  
  
  business    Business @relation(fields: [businessId], references: [id])
  businessId  String
  
  // Jerarquía de categorías
  parentId    String?
  parent      Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  
  // Relaciones
  productCategories ProductCategory[]
  
  // Auditoría
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Atributos dinámicos para productos
model ProductAttribute {
  id          String   @id @default(uuid())
  product     Product  @relation(fields: [productId], references: [id])
  productId   String
  key         String   // Ej: "talla", "color", "material", "ingredientes"
  value       String   // Valor del atributo
  type        String   @default("text") // text, number, boolean, date
  
  createdAt   DateTime @default(now())

  @@unique([productId, key]) // Un producto no puede tener el mismo atributo duplicado
}

// Tabla intermedia para relación N:N entre Product y Category
model ProductCategory {
  id         String   @id @default(uuid())
  product    Product  @relation(fields: [productId], references: [id])
  productId  String
  category   Category @relation(fields: [categoryId], references: [id])
  categoryId String
  createdAt  DateTime @default(now())

  @@unique([productId, categoryId]) // Evita duplicados
}

model Client {
  id         String   @id @default(uuid())
  dni        String?  @unique
  name       String
  email      String?
  phone      String?
  address    String?
  business   Business @relation(fields: [businessId], references: [id])
  businessId String
  sales      Sale[]   // Relación 1:N - un cliente puede tener muchas ventas
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  isDeleted  Boolean  @default(false) // Eliminación lógica
}


model Sale {
  id           String   @id @default(uuid())
  subtotal     Float    // Suma de items sin descuentos
  discountType DiscountType? // Tipo de descuento aplicado
  discountValue Float?   // Valor del descuento
  total        Float    // Precio final después de descuentos
  status       SaleStatus @default(PENDING)
  
  business     Business @relation(fields: [businessId], references: [id])
  businessId   String
  client       Client?  @relation(fields: [clientId], references: [id])
  clientId     String?
  
  items        SaleItem[]
  payments     Payment[] // Pagos realizados
  discounts    SaleDiscount[] // Descuentos aplicados (para casos complejos)
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SaleItem {
  id        String  @id @default(uuid())
  quantity  Int
  price     Float   // Precio al momento de la venta
  sale      Sale    @relation(fields: [saleId], references: [id])
  saleId    String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  createdAt DateTime @default(now())
}

model Payment {
  id            String        @id @default(uuid())
  amount        Float
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  reference     String?       // Número de referencia, transacción, etc.
  notes         String?       // Notas adicionales
  
  // Relación con Sale
  sale          Sale          @relation(fields: [saleId], references: [id])
  saleId        String
  
  // Relación con Business
  business      Business      @relation(fields: [businessId], references: [id])
  businessId    String
  
  // Campos de auditoría
  paidAt        DateTime?     // Fecha real del pago
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  
  @@index([saleId])
  @@index([businessId])
  @@index([status])
}

model Expense {
  id          String   @id @default(uuid())
  amount      Float
  description String
  type        ExpenseType
  date        DateTime
  business    Business @relation(fields: [businessId], references: [id])
  businessId  String
  createdAt   DateTime @default(now())
}

enum SaleStatus {
  PENDING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum ExpenseType {
  SALARY      // Sueldo - asociado a usuario
  RENT        // Renta
  UTILITIES   // Servicios
  SUPPLIES    // Suministros
  MARKETING   // Marketing
  OTHER       // Otros
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  DIGITAL_WALLET
  CHECK
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

enum DiscountType {
  PERCENTAGE   // Porcentaje (ej: 10%)
  FIXED_AMOUNT // Monto fijo (ej: $50)
  BUY_X_GET_Y  // Promociones especiales
  COUPON       // Cupón de descuento
  LOYALTY      // Descuento por fidelidad
  BULK         // Descuento por volumen
}

model SaleDiscount {
  id           String      @id @default(uuid())
  type         DiscountType
  value        Float       // Valor del descuento
  description  String?     // Descripción del descuento
  couponCode   String?     // Código de cupón si aplica
  
  // Relación con Sale
  sale         Sale        @relation(fields: [saleId], references: [id])
  saleId       String
  
  // Relación con Business
  business     Business    @relation(fields: [businessId], references: [id])
  businessId   String
  
  createdAt    DateTime    @default(now())
  
  @@index([saleId])
  @@index([couponCode])
}