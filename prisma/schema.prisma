// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OWNER
  EMPLOYEE
}

enum AuthProvider {
  CREDENTIALS
  GOOGLE
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  password   String?  // Null si es login por Google
  name       String?
  role       Role   @default(OWNER)
  provider   AuthProvider @default(CREDENTIALS) // Enum en lugar de String
  providerId String?  // ID externo (Google ID, etc.)
  
  // Campos para confirmación de email
  isEmailVerified Boolean @default(false)
  emailVerificationToken String? @unique // Token para verificar email
  emailVerificationExpires DateTime? // Fecha de expiración del token
  
  // Campos para recuperación de contraseña
  passwordResetToken String? @unique
  passwordResetExpires DateTime?
  
  // Campos de auditoría
  registeredAt  DateTime @default(now())
  lastLoginAt   DateTime?
  updatedAt     DateTime @updatedAt
  
  // Relación 1:1 con Profile (opcional)
  profile    Profile?
  
  // Relación N:N con Business a través de UserBusiness
  userBusinesses UserBusiness[]
}

model Profile {
  id          String   @id @default(uuid())
  username    String?  @unique
  avatar      String?
  phone       String?
  secondaryEmail String?
  description String?
  isActive    Boolean  @default(true)
  
  // Relación 1:1 con User
  user        User     @relation(fields: [userId], references: [id])
  userId      String   @unique // Garantiza relación 1:1
  
  // Campos de auditoría
  updatedAt   DateTime @updatedAt
}

model Business {
  id         String   @id @default(uuid())
  name       String
  logo       String?
  description String?
  address    String?
  phone      String?
  email      String?
  website    String?
  
  // Relación N:N con User a través de UserBusiness
  userBusinesses UserBusiness[]
  
  products   Product[] // Relación 1:N - un negocio puede tener muchos productos
  sales      Sale[]   // Relación 1:N - un negocio puede tener muchas ventas
  expenses   Expense[] // Relación 1:N - un negocio puede tener muchos gastos
  businessClients BusinessClient[] // Tabla intermedia para relación N:N con clientes
  categories Category[] // Categorías específicas del negocio
  createdAt  DateTime @default(now())
}

// Nueva tabla intermedia para relación N:N entre User y Business
model UserBusiness {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  business   Business @relation(fields: [businessId], references: [id])
  businessId String
  
  // Campos adicionales para la relación
  role       Role     @default(EMPLOYEE) // Rol del usuario en este negocio específico
  isActive   Boolean  @default(true)
  joinedAt   DateTime @default(now())
  

  @@unique([userId, businessId]) // Evita duplicados
}

enum ProductType {
  PHYSICAL    // Producto físico (ropa, tecnología, etc.)
  DIGITAL     // Producto digital (software, ebooks, etc.)
  SERVICE     // Servicio (consultoría, mantenimiento, etc.)
  FOOD        // Comida y bebidas
  SUBSCRIPTION // Suscripciones
}

model Product {
  id          String      @id @default(uuid())
  name        String
  price       Float
  description String?
  stock       Int         @default(0)
  type        ProductType @default(PHYSICAL)
  
  // Campos específicos por tipo
  sku         String?     @unique // Código de producto
  barcode     String?     // Código de barras
  weight      Float?      // Peso en kg
  dimensions  String?     // Dimensiones (LxWxH)
  
  // Campos para productos físicos
  isActive    Boolean     @default(true)
  isFeatured  Boolean     @default(false)
  
  // Relaciones
  business    Business    @relation(fields: [businessId], references: [id])
  businessId  String
  productCategories ProductCategory[]
  productAttributes ProductAttribute[] // Atributos dinámicos
  saleItems   SaleItem[]
  
  // Auditoría
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Category {
  id          String   @id @default(uuid())
  name        String
  description String?
  icon        String?  // Icono para UI
  color       String?  // Color para UI
  
  // Relación con Business (OPCIONAL)
  business    Business? @relation(fields: [businessId], references: [id])
  businessId  String?   // Null = categoría global, String = categoría específica
  
  // Jerarquía de categorías
  parentId    String?
  parent      Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  
  // Relaciones
  productCategories ProductCategory[]
  
  // Auditoría
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Atributos dinámicos para productos
model ProductAttribute {
  id          String   @id @default(uuid())
  product     Product  @relation(fields: [productId], references: [id])
  productId   String
  key         String   // Ej: "talla", "color", "material", "ingredientes"
  value       String   // Valor del atributo
  type        String   @default("text") // text, number, boolean, date
  
  createdAt   DateTime @default(now())

  @@unique([productId, key]) // Un producto no puede tener el mismo atributo duplicado
}

// Tabla intermedia para relación N:N entre Product y Category
model ProductCategory {
  id         String   @id @default(uuid())
  product    Product  @relation(fields: [productId], references: [id])
  productId  String
  category   Category @relation(fields: [categoryId], references: [id])
  categoryId String
  createdAt  DateTime @default(now())

  @@unique([productId, categoryId]) // Evita duplicados
}

model Client {
  id         String   @id @default(uuid())
  name       String
  email      String?
  phone      String?
  address    String?
  businessClients BusinessClient[] // Tabla intermedia para relación N:N con negocios
  sales      Sale[]   // Relación 1:N - un cliente puede tener muchas ventas
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Tabla intermedia para relación N:N entre Business y Client
model BusinessClient {
  id         String   @id @default(uuid())
  business   Business @relation(fields: [businessId], references: [id])
  businessId String
  client     Client   @relation(fields: [clientId], references: [id])
  clientId   String
  createdAt  DateTime @default(now())

  @@unique([businessId, clientId]) // Evita duplicados
}

model Sale {
  id         String   @id @default(uuid())
  total      Float
  status     SaleStatus @default(PENDING)
  business   Business @relation(fields: [businessId], references: [id])
  businessId String
  client     Client?  @relation(fields: [clientId], references: [id]) // Opcional - venta sin cliente
  clientId   String?
  items      SaleItem[] // Relación 1:N - una venta puede tener muchos items
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model SaleItem {
  id        String  @id @default(uuid())
  quantity  Int
  price     Float   // Precio al momento de la venta
  sale      Sale    @relation(fields: [saleId], references: [id])
  saleId    String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  createdAt DateTime @default(now())
}

model Expense {
  id          String   @id @default(uuid())
  amount      Float
  description String
  type        ExpenseType
  date        DateTime
  business    Business @relation(fields: [businessId], references: [id])
  businessId  String
  createdAt   DateTime @default(now())
}

enum SaleStatus {
  PENDING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum ExpenseType {
  SALARY      // Sueldo - asociado a usuario
  RENT        // Renta
  UTILITIES   // Servicios
  SUPPLIES    // Suministros
  MARKETING   // Marketing
  OTHER       // Otros
}